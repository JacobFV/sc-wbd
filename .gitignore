.env
paper/output/

# environments
.venv/

# large, hash-manifest-tracked artifacts (ARCHITECTURE.md sec. 1)
#
# Both forms of each name. A trailing slash matches a DIRECTORY only, and in
# every worktree these are SYMLINKS into /data/scwbd -- so `assets/` did not
# match `assets` and a `git add -A` committed the symlink. Checking that blob
# out in the main repo replaced its `assets` symlink with one pointing at
# itself, and every worktree that resolves through the main repo then got
# ELOOP out of `load_anatomy`. See reports/dynamics/family_state.md.
assets
assets/
data
data/
checkpoints
checkpoints/

# generated figures; the machine-readable claim reports themselves are tracked
reports/**/*.png

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# bench solver cache (content-keyed; safe to delete)
.cache/
