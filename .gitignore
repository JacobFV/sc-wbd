.env
paper/output/

# environments
.venv/

# large, hash-manifest-tracked artifacts (ARCHITECTURE.md sec. 1)
# Both forms of each name are required. A trailing slash matches a DIRECTORY
# ONLY -- it does not match a symlink of the same name, so `assets/` alone left
# the `assets` symlink trackable and one `git add -A` committed it. The blob's
# target string was a worktree-local path; checking it out in the main repo made
# assets point at itself and every worktree resolving through it got ELOOP.
assets
assets/
data
data/
checkpoints
checkpoints/

# generated figures; the machine-readable claim reports themselves are tracked
reports/**/*.png

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# bench solver cache (content-keyed; safe to delete)
.cache/

# public site + release comms (Tufte). Build products, never committed.
# Both forms of each name, per the ELOOP note above.
site/_build
site/_build/
.wrangler
.wrangler/

# Generated by "make release-003-derived" from a checkpoint. Committed only
# once it describes a trained run; an untrained copy reads as a finding.
reports/attachment_kinds.json
reports/attachment_kinds.md

# Ablation scratch: source_ablation redirects checkpoints and reports here so it
# cannot overwrite the run it is evaluating (ISSUE-010). Arms are inspectable
# but are not artifacts of any run.
checkpoints/*-ablation-scratch/
checkpoints/*-ablation-debris/
reports/training/*-ablation/

# Smoke scratch: the pre-launch smoke (scripts/launch_run4.sh step 5) redirects
# its report_dir, checkpoints and log here so it cannot overwrite the run it is
# checking. It once replaced 22,113 lines of run 3's
# mixture_T1_measured_founding.json with 81 lines of its own. Same class as the
# ablation scratch above, one directory over.
reports/training/smoke-0*/
checkpoints/*-smoke/
reports/run4_posterior/_smoke/
